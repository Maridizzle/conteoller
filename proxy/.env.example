# --- Lovense developer credentials ---
LOVENSE_TOKEN=changeme-secret-dev-token
LOVENSE_UID=our-stable-user-id
LOVENSE_SALT=changeme-salt

# --- Panel access ---
PANEL_PASSWORD=changeme
# Optional shared secret for server-to-server calls to /command and /stop.
# Never put this in client-side JS; it is never sent to the browser.
PANEL_API_KEY=changeme-api-key
SESSION_SECRET=changeme-session-secret

# --- Network ---
PORT=3000
# Public HTTPS URL of this proxy, used to build the Lovense callback URL.
CALLBACK_PUBLIC_URL=https://your-app.up.railway.app

# --- Lovense endpoints [see src/config.js for confidence tags] ---
# [VERIFIED / first-party]
LOVENSE_QR_URL=https://api.lovense.com/api/lan/getQrCode
# [COMMUNITY - MUST CONFIRM, spec Step 0 item 1]
LOVENSE_COMMAND_URL=https://api.lovense.com/api/lan/v2/command

# --- Tunables pending Step 0 confirmation ---
# [MUST CONFIRM, Step 0 item 5] minimum ms between commands to the same toy.
MIN_COMMAND_INTERVAL_MS=350
# Hold duration per command; renewals fire at HOLD_SECONDS * 0.66.
HOLD_SECONDS=12
# [MUST CONFIRM, Step 0 item 2] does the server path accept per-motor
# actions like Vibrate1/Vibrate2? Flip to "false" to fall back to a single
# combined Vibrate channel if it turns out it does not.
LOVENSE_SUPPORTS_PER_MOTOR=true
